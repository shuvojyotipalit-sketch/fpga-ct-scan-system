
%% FPGA-Based CT Scan Imaging System - Complete MATLAB Code
%% Run this entire script at once in MATLAB

clc; clear; close all;

%% ---- STEP 1: Create Phantom Image -------------------------
fprintf('Step 1: Generating phantom image...\n');

phantom_img = phantom('Modified Shepp-Logan', 256);

figure(1);
imshow(phantom_img, []);
title('STEP 1 - Original Phantom Image');


%% ---- STEP 2: Create Sinogram (Radon Transform) ------------
fprintf('Step 2: Creating sinogram...\n');

theta = 0:1:179;
[sinogram, xp] = radon(phantom_img, theta);
sinogram_norm = mat2gray(sinogram);

figure(2);
imagesc(theta, xp, sinogram_norm);
colormap gray;
xlabel('Projection Angle (degrees)');
ylabel('Detector Position');
title('STEP 2 - Sinogram (Raw CT Data)');
colorbar;


%% ---- STEP 3: Apply Ram-Lak Filter -------------------------
fprintf('Step 3: Applying Ram-Lak filter...\n');

[rows, cols] = size(sinogram);
N = 2^nextpow2(2*rows - 1);
freq = (-N/2 : N/2-1) / N;
ramlak = abs(freq);

filtered_sinogram = zeros(rows, cols);
for col = 1:cols
    proj_fft          = fft(sinogram(:, col), N);
    proj_fft_centered = fftshift(proj_fft);
    filtered_fft      = proj_fft_centered .* ramlak';
    proj_filtered     = real(ifft(ifftshift(filtered_fft)));
    filtered_sinogram(:, col) = proj_filtered(1:rows);
end

figure(3);
imagesc(filtered_sinogram);
colormap gray;
title('STEP 3 - Filtered Sinogram (After Ram-Lak Filter)');


%% ---- STEP 4: Reconstruct Image (FBP) ----------------------
fprintf('Step 4: Reconstructing image using FBP...\n');

reconstructed = iradon(filtered_sinogram, theta, 'linear', 'Ram-Lak');

figure(4);
imshow(reconstructed, []);
title('STEP 4 - Reconstructed CT Image (FBP)');


%% ---- STEP 5: Compare Original vs Reconstructed -----------
fprintf('Step 5: Comparing images...\n');

% Fix size mismatch between iradon output and original phantom
reconstructed_resized = imresize(reconstructed, size(phantom_img));

figure(5);
subplot(1,2,1);
imshow(phantom_img, []);
title('Original Phantom');

subplot(1,2,2);
imshow(reconstructed_resized, []);
title('Reconstructed Image');

% Now PSNR will work correctly
psnr_val = psnr(mat2gray(reconstructed_resized), phantom_img);
fprintf('✅ PSNR Value: %.2f dB\n', psnr_val);
fprintf('   (Good quality = above 30 dB)\n');


%% ---- STEP 6: Convert to Fixed-Point (for FPGA) -----------
fprintf('Step 6: Converting to fixed-point for FPGA...\n');

scale_factor = 2^15 - 1;
sino_norm    = sinogram / max(abs(sinogram(:)));
sino_fixed   = int16(sino_norm * scale_factor);

csvwrite('sinogram_fixed.csv', double(sino_fixed));
fprintf('✅ Fixed-point sinogram saved as sinogram_fixed.csv\n');

sino_back = double(sino_fixed) / scale_factor;
error_val = max(abs(sino_norm(:) - sino_back(:)));
fprintf('✅ Max quantization error: %.6f\n', error_val);


%% ---- STEP 7: Generate Sine/Cosine Lookup Tables ----------
fprintf('Step 7: Generating sin/cos lookup tables for FPGA...\n');

angles_rad = (0:179) * pi / 180;
sin_table  = int16(sin(angles_rad) * 32767);
cos_table  = int16(cos(angles_rad) * 32767);

% Save as HEX files (used in Verilog $readmemh)
fid = fopen('sin_table.hex', 'w');
for i = 1:180
    fprintf(fid, '%04X\n', typecast(sin_table(i), 'uint16'));
end
fclose(fid);

fid = fopen('cos_table.hex', 'w');
for i = 1:180
    fprintf(fid, '%04X\n', typecast(cos_table(i), 'uint16'));
end
fclose(fid);

fprintf('✅ sin_table.hex and cos_table.hex saved!\n');


%% ---- STEP 8: Generate FIR Filter Coefficients ------------
fprintf('Step 8: Generating Ram-Lak FIR coefficients...\n');

N_taps = 32;
h      = fir1(N_taps - 1, 0.9, 'high') * 32767;
h_fixed = int16(h);

fid = fopen('ramlak_coeffs.hex', 'w');
for i = 1:N_taps
    fprintf(fid, '%04X\n', typecast(h_fixed(i), 'uint16'));
end
fclose(fid);

fprintf('✅ ramlak_coeffs.hex saved!\n');
fprintf('\n🎉 ALL STEPS COMPLETE! Files saved in current MATLAB folder.\n');
fprintf('   → sinogram_fixed.csv\n');
fprintf('   → sin_table.hex\n');
fprintf('   → cos_table.hex\n');
fprintf('   → ramlak_coeffs.hex\n');
