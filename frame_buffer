module frame_buffer #(
    parameter IMG_SIZE   = 16,
    parameter DATA_WIDTH = 16,
    parameter ADDR_WIDTH = 5
)(
    input  wire                  clk,
    input  wire                  rst_n,
    input  wire [DATA_WIDTH-1:0] data_in,
    input  wire                  wr_en,
    output reg  [DATA_WIDTH-1:0] pixel_out,
    output reg                   out_valid,
    output reg                   done
);
    reg [DATA_WIDTH-1:0] bram [0:IMG_SIZE-1];
    reg [ADDR_WIDTH-1:0] wr_addr;
    reg [ADDR_WIDTH-1:0] rd_addr;
    reg                  read_phase;
    integer k;

    initial begin
        for (k = 0; k < IMG_SIZE; k = k+1)
            bram[k] = 0;
    end

    // WRITE
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            wr_addr    <= 0;
            done       <= 0;
            read_phase <= 0;
        end else if (wr_en && !read_phase) begin
            bram[wr_addr] <= data_in;
            $display("BRAM WRITE addr=%0d data=%0d", wr_addr, data_in);
            if (wr_addr < IMG_SIZE - 1)
                wr_addr <= wr_addr + 1;
            else begin
                done       <= 1;
                read_phase <= 1;
                wr_addr    <= 0;
                $display("✅ Frame Buffer FULL - done=1");
            end
        end
    end

    // READ
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            rd_addr   <= 0;
            out_valid <= 0;
            pixel_out <= 0;
        end else if (read_phase) begin
            pixel_out <= bram[rd_addr];
            out_valid <= 1;
            $display("BRAM READ addr=%0d pixel=%0d", rd_addr, bram[rd_addr]);
            if (rd_addr < IMG_SIZE - 1)
                rd_addr <= rd_addr + 1;
            else
                rd_addr <= 0;
        end
    end
endmodule
